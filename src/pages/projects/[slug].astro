---
import { getProjectStaticPaths, projectDetailCta } from "@data/projects";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";

import ProjectCaseStudyList from "@/components/projects/ProjectCaseStudyList.astro";
import ProjectCaseStudySummary from "@/components/projects/ProjectCaseStudySummary.astro";
import ProjectFacts from "@/components/projects/ProjectFacts.astro";
import ProjectGallery from "@/components/projects/ProjectGallery.astro";
import ProjectHero from "@/components/projects/ProjectHero.astro";
import ProjectKeyFeatures from "@/components/projects/ProjectKeyFeatures.astro";
import ProjectTechStack from "@/components/projects/ProjectTechStack.astro";
import FooterCTA from "@/components/shared/FooterCTA.astro";
import { Lightbulb, Rocket, Wrench, ArrowRight } from "@lucide/astro";

import type { ProjectFeature } from "@content-types/content";

export function getStaticPaths() {
  return getProjectStaticPaths();
}

const { project } = Astro.props;
const repoUrl = project.links.find((link) => link.type === "github")?.href;
const featureItems = project.caseStudy.features as ProjectFeature[];
const challenges = project.caseStudy.challenges;
const learnings = project.caseStudy.learned;
const improvements = project.caseStudy.futureImprovements;
---

<BaseLayout title={project.seo.title} description={project.seo.description}>
  <Container class="flex flex-col gap-8 lg:gap-6">
    <ProjectHero project={project} />
    <ProjectFacts project={project} />
    <ProjectCaseStudySummary caseStudy={project.caseStudy} />

    <div
      class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]"
    >
      <ProjectKeyFeatures title="Key features" features={featureItems} />
      <ProjectTechStack techStack={project.stack} />
    </div>

    <ProjectGallery images={project.gallery} />

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
      <ProjectCaseStudyList
        title="Challenges"
        icon={Wrench}
        items={challenges}
        listType="numbered"
      />

      <ProjectCaseStudyList
        title="What I learned"
        icon={Lightbulb}
        items={learnings}
        listType="bullet"
      />

      <ProjectCaseStudyList
        title="Future improvements"
        icon={Rocket}
        items={improvements}
        listType="arrow"
      />
    </div>

    <FooterCTA
      title={projectDetailCta.title}
      description={projectDetailCta.description}
    >
      {
        repoUrl && (
          <Button
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            aria-label={`Open ${project.title} GitHub repository`}
          >
            <Icon
              name="simple-icons:github"
              class="size-4"
              aria-hidden="true"
            />

            {projectDetailCta.secondaryLabel}
          </Button>
        )
      }
      <Button variant="primary" href={projectDetailCta.primaryHref}>
        {projectDetailCta.primaryLabel}
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </FooterCTA>
  </Container>
</BaseLayout>
