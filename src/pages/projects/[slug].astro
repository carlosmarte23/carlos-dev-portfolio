---
import {
  getProjectStaticPaths,
  projectDetailContent,
  projectDetailCta,
} from "@data/projects";
import BaseLayout from "@layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { Icon } from "astro-icon/components";

import ProjectCaseStudyList from "@/components/projects/ProjectCaseStudyList.astro";
import ProjectCaseStudySummary from "@/components/projects/ProjectCaseStudySummary.astro";
import ProjectFacts from "@/components/projects/ProjectFacts.astro";
import ProjectGallery from "@/components/projects/ProjectGallery.astro";
import ProjectHero from "@/components/projects/ProjectHero.astro";
import ProjectKeyFeatures from "@/components/projects/ProjectKeyFeatures.astro";
import ProjectTechStack from "@/components/projects/ProjectTechStack.astro";
import FooterCTA from "@/components/shared/FooterCTA.astro";
import { Lightbulb, Rocket, Wrench, ArrowRight } from "@lucide/astro";

import type { ProjectFeature } from "@content-types/content";

export function getStaticPaths() {
  return getProjectStaticPaths();
}

const { project } = Astro.props;
const repoUrl = project.links.find((link) => link.type === "github")?.href;
const featureItems = project.caseStudy.features as ProjectFeature[];
const challenges = project.caseStudy.challenges;
const learnings = project.caseStudy.learned;
const improvements = project.caseStudy.futureImprovements;
const projectUrl = new URL(Astro.url.pathname, Astro.site).toString();
const projectImage = new URL(
  project.seo.ogImage ?? project.coverImage.src,
  Astro.site,
).toString();
const projectStructuredData = [
  {
    "@type": "CreativeWork",
    "@id": `${projectUrl}#project`,
    url: projectUrl,
    name: project.title,
    headline: project.seo.title,
    description: project.seo.description,
    image: projectImage,
    dateCreated: project.year,
    datePublished: project.publishedAt,
    dateModified: project.updatedAt,
    creator: {
      "@id": `${Astro.site}#person`,
    },
    programmingLanguage: project.stack.map((tech) => tech.name),
    keywords: project.focus,
  },
];
---

<BaseLayout
  title={project.seo.title}
  description={project.seo.description}
  ogImage={project.seo.ogImage}
  ogImageAlt={project.seo.ogImageAlt}
  structuredData={projectStructuredData}
>
  <Container class="flex flex-col gap-8 lg:gap-6">
    <ProjectHero
      project={project}
      backLabel={projectDetailContent.backLabel}
      eyebrow={projectDetailContent.eyebrow}
      techStackContent={projectDetailContent.techStack}
    />
    <ProjectFacts project={project} content={projectDetailContent.facts} />
    <ProjectCaseStudySummary
      caseStudy={project.caseStudy}
      content={projectDetailContent.caseStudySummary}
    />

    <div
      class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]"
    >
      <ProjectKeyFeatures
        title={projectDetailContent.keyFeaturesTitle}
        features={featureItems}
      />
      <ProjectTechStack
        techStack={project.stack}
        content={projectDetailContent.techStack}
      />
    </div>

    <ProjectGallery
      images={project.gallery}
      title={projectDetailContent.gallery.title}
    />

    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
      <ProjectCaseStudyList
        title={projectDetailContent.caseStudyLabels.challenges}
        icon={Wrench}
        items={challenges}
        listType="numbered"
      />

      <ProjectCaseStudyList
        title={projectDetailContent.caseStudyLabels.learned}
        icon={Lightbulb}
        items={learnings}
        listType="bullet"
      />

      <ProjectCaseStudyList
        title={projectDetailContent.caseStudyLabels.futureImprovements}
        icon={Rocket}
        items={improvements}
        listType="arrow"
      />
    </div>

    <FooterCTA
      title={projectDetailCta.title}
      description={projectDetailCta.description}
    >
      {
        repoUrl && (
          <Button
            href={repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            aria-label={`Open ${project.title} GitHub repository`}
          >
            <Icon
              name="simple-icons:github"
              class="size-4"
              aria-hidden="true"
            />

            {projectDetailCta.secondaryLabel}
          </Button>
        )
      }
      <Button variant="primary" href={projectDetailCta.primaryHref}>
        {projectDetailCta.primaryLabel}
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </FooterCTA>
  </Container>
</BaseLayout>
