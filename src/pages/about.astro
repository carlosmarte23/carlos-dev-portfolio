---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import AboutFocusAreas from "@/components/about/AboutFocusAreas.astro";
import AboutHero from "@/components/about/AboutHero.astro";
import AboutStory from "@/components/about/AboutStory.astro";
import AboutValues from "@/components/about/AboutValues.astro";
import FooterCTA from "@/components/shared/FooterCTA.astro";
import { site } from "@data/site";
import { aboutPage } from "@data/pages/about";

import { ArrowRight } from "@lucide/astro";

const { name: profileName, role, location, headline, availability } = site;

const {
  title: aboutTitle,
  intro: aboutIntro,
  focus,
  values: buildValues,
  focusAreas,
  cta: aboutCta,
  seo,
} = aboutPage;

const { title: aboutCtaTitle, description: aboutCtaDescription } = aboutCta;
---

<BaseLayout title={seo.title} description={seo.description}>
  <Container>
    <AboutHero
      title={aboutTitle}
      intro={aboutIntro}
      profileName={profileName}
      role={role}
      location={location}
      positioning={headline}
      availabilityLabel={availability}
      isOpenToWork={availability === "Open to work"}
      focus={focus}
    />

    <AboutStory story={aboutPage.story} />
    <AboutValues values={buildValues} />
    <AboutFocusAreas focusAreas={focusAreas} />

    <FooterCTA title={aboutCtaTitle} description={aboutCtaDescription}>
      <Button href={aboutCta.primaryHref} variant="primary">
        <span>{aboutCta.primaryLabel}</span>
        <ArrowRight
          name="simple-icons:github"
          class="size-4"
          aria-hidden="true"
        />
      </Button>
      {
        aboutCta.secondaryHref && aboutCta.secondaryLabel && (
          <Button variant="secondary" href={aboutCta.secondaryHref}>
            {aboutCta.secondaryLabel}
            <ArrowRight class="size-4" aria-hidden="true" />
          </Button>
        )
      }
    </FooterCTA>
  </Container>
</BaseLayout>
