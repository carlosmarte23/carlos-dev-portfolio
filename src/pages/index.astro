---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import TechStack from "@/components/home/TechStack.astro";
import AboutPreview from "@/components/home/AboutPreview.astro";
import AboutThisSite from "./about-this-site.astro";
import ContactCTA from "@/components/home/ContactCTA.astro";
import { homePage } from "@data/pages/home";
---

<BaseLayout
  title={homePage.seo.title}
  description={homePage.seo.description}
  class="flex flex-col gap-3"
>
  <HomeHero />
  <FeaturedProjects />
  <TechStack />
  <AboutPreview />
  <AboutThisSite />
  <ContactCTA />
</BaseLayout>
