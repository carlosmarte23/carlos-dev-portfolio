---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Carlos Marte | Frontend Developer"
  description="Frontend Developer focused on clean, responsive web experiences."
>
  <main class="min-h-screen bg-app text-main">
    <section class="mx-auto w-full max-w-6xl px-4 py-24 sm:px-6 lg:px-8">
      <p class="font-mono">carlos@portfolio:~$</p>

      <h1 class="mt-4 font-display text-5xl font-bold tracking-tight">
        Portfolio setup ready.
      </h1>

      <p class="mt-4 max-w-2xl text-accent">
        Astro, Tailwind v4, React and custom theme tokens are working.
      </p>
    </section>
  </main>
</BaseLayout>
