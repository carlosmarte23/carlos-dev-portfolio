---
import BaseLayout from "@/layouts/BaseLayout.astro";
import HomeHero from "@/components/home/HomeHero.astro";
import FeaturedProjects from "@/components/home/FeaturedProjects.astro";
import TechStack from "@/components/home/TechStack.astro";
import AboutPreview from "@/components/home/AboutPreview.astro";
import FooterCTA from "@/components/shared/FooterCTA.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { ArrowRight } from "@lucide/astro";
import { homePage } from "@data/pages/home";

const { contactCta } = homePage;
---

<BaseLayout
  title={homePage.seo.title}
  description={homePage.seo.description}
  ogImage={homePage.seo.ogImage}
  ogImageAlt={homePage.seo.ogImageAlt}
  class="flex flex-col gap-3"
>
  <HomeHero />
  <FeaturedProjects />
  <TechStack />
  <AboutPreview />
  <section class="pt-10 pb-4 md:pt-14 lg:pt-16">
    <Container>
      <FooterCTA title={contactCta.title} description={contactCta.description}>
        <Button href={contactCta.primaryHref} class="w-full md:w-auto">
          {contactCta.primaryLabel}
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        {
          contactCta.secondaryHref && contactCta.secondaryLabel && (
            <Button
              variant="secondary"
              href={contactCta.secondaryHref}
              class="w-full md:w-auto"
            >
              {contactCta.secondaryLabel}
              <ArrowRight class="size-4" aria-hidden="true" />
            </Button>
          )
        }
      </FooterCTA>
    </Container>
  </section>
</BaseLayout>
