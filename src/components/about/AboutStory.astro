---
import type { AboutStory as AboutStoryData } from "@content-types/content";
import { ArrowRight } from "@lucide/astro";

interface Props {
  story: AboutStoryData;
  eyebrow: string;
  readMoreLabel: string;
}

const { story, eyebrow, readMoreLabel } = Astro.props;
const { title, summary, items } = story;
---

<section
  class="timeline-view my-8 animate-slide-up-fade border-b border-line pb-8 animate-range-[entry_0%_contain_22%] animate-duration-slow animate-bezier-expo-out lg:grid lg:grid-cols-[0.85fr_minmax(0,3fr)] lg:gap-10"
>
  <header class="flex flex-col gap-3 lg:border-r lg:border-line lg:pr-8">
    <div class="flex items-center gap-3 font-mono text-accent">
      <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
      <p>{eyebrow}</p>
    </div>
    <h2 class="font-display text-2xl font-bold text-main">
      {title}
    </h2>
    <p class="text-muted">{summary}</p>
  </header>

  <details class="mt-6 lg:hidden">
    <summary
      class="flex cursor-pointer list-none items-center gap-2 font-mono text-sm font-semibold text-accent"
    >
      {readMoreLabel}
      <ArrowRight class="size-4" aria-hidden="true" />
    </summary>

    <div>
      {
        items.map((paragraph, index) => (
          <article class="mt-4 grid gap-2">
            <span class="font-mono text-sm font-bold text-accent">
              {String(index + 1).padStart(2, "0")}.
            </span>{" "}
            <p class="leading-7 text-muted">{paragraph}</p>
          </article>
        ))
      }
    </div>
  </details>

  <div
    class="relative hidden before:absolute before:top-4.5 before:right-[30%] before:left-0 before:h-px before:border-t before:border-dashed before:border-accent/45 lg:grid lg:grid-cols-3 lg:gap-8 lg:pt-1 lg:before:block"
  >
    {
      items.map((paragraph, index) => (
        <article class="relative grid content-start gap-6">
          <span class="relative z-10 inline-flex size-7 items-center justify-center rounded-full border border-accent bg-app font-mono font-bold text-accent shadow-glow ring-6 ring-app">
            {String(index + 1).padStart(2, "0")}
          </span>{" "}
          <span class="max-w-[34ch] leading-7 text-muted">{paragraph}</span>
        </article>
      ))
    }
  </div>
</section>
