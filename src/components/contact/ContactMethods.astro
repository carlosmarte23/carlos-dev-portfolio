---
import Card from "@/components/ui/Card.astro";
import { ArrowUpRight, Mail } from "@lucide/astro";
import { Icon } from "astro-icon/components";
import type { ContactPage } from "@content-types/content";

interface Props {
  methods: ContactPage["contactMethods"];
}

const { methods } = Astro.props;

const contactMethodIconClasses: Record<string, string> = {
  Email: "border-accent/30 bg-accent-soft text-accent",
  LinkedIn: "border-sky-400/30 bg-sky-400/10 text-sky-400",
  GitHub: "border-line-strong bg-surface-muted text-main",
};

const brandIcons: Record<string, string> = {
  github: "simple-icons:github",
  linkedin: "simple-icons:linkedin",
};
---

<section class="my-8 flex flex-col gap-6 border-b border-line pb-8">
  <header class="flex flex-col gap-3">
    <div class="flex items-center gap-3 font-mono text-accent">
      <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
      <p>Contact methods</p>
    </div>
  </header>

  <div class="flex flex-col gap-4 lg:grid lg:grid-cols-3 lg:gap-6">
    {
      methods.map((method) => {
        const iconClasses = contactMethodIconClasses[method.label];
        const brandIcon = brandIcons[method.icon];

        return (
          <Card padding="sm">
            <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-4">
              <div>
                <span
                  class={`inline-flex size-10 shrink-0 items-center justify-center rounded-button border ${iconClasses}`}
                >
                  {brandIcon ? (
                    <Icon name={brandIcon} class="size-6" aria-hidden="true" />
                  ) : (
                    <Mail class="size-6" aria-hidden="true" />
                  )}
                </span>
              </div>

              <div class="min-w-0 space-y-4">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-display text-xl font-bold text-main">
                    {method.label}
                  </h3>

                  {method.isPrimary && (
                    <span class="shrink-0 rounded-button border border-accent/40 bg-accent-soft px-2.5 py-1 font-mono text-xs font-bold text-accent uppercase">
                      Primary
                    </span>
                  )}
                </div>

                <p class="text-muted">{method.description}</p>
                <a
                  href={method.href}
                  class="inline-flex w-fit max-w-full items-center gap-2 font-mono text-sm font-semibold text-accent transition hover:text-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
                  target={method.external ? "_blank" : undefined}
                  rel={method.external ? "noopener noreferrer" : undefined}
                >
                  <span>{method.linkLabel}</span>
                  <ArrowUpRight class="size-4 shrink-0" aria-hidden="true" />
                </a>
              </div>
            </div>
          </Card>
        );
      })
    }
  </div>
</section>
