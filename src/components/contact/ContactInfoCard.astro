---
import Card from "@/components/ui/Card.astro";
import {
  Check,
  ChevronRight,
  Clock,
  MessageSquare,
  ShieldCheck,
} from "@lucide/astro";

type IconKey = "message" | "clock" | "shield";
type ListIcon = "chevron" | "check";

interface Props {
  title: string;
  icon: IconKey;
  description?: string;
  items?: readonly string[];
  listIcon?: ListIcon;
}

const {
  title,
  icon,
  description,
  items = [],
  listIcon = "chevron",
} = Astro.props;

const supportCardIcons = {
  message: MessageSquare,
  clock: Clock,
  shield: ShieldCheck,
};

const IconComponent = supportCardIcons[icon];
const ItemIcon = listIcon === "check" ? Check : ChevronRight;
const contentSpacing = description ? "space-y-2" : "space-y-3";
---

<Card padding="sm">
  <div class="grid grid-cols-[auto_minmax(0,1fr)] gap-4">
    <span
      class="inline-flex size-10 shrink-0 items-center justify-center rounded-button border border-accent/30 bg-accent-soft text-accent"
    >
      <IconComponent class="size-5" aria-hidden="true" />
    </span>

    <div class={`min-w-0 ${contentSpacing}`}>
      <h3 class="font-mono text-sm font-semibold text-accent uppercase">
        {title}
      </h3>

      {description && <p class="text-muted">{description}</p>}

      {
        items.length > 0 && (
          <div class="flex flex-col gap-2">
            {items.map((item) => (
              <div class="flex items-center gap-2">
                <ItemIcon
                  class="size-4 shrink-0 text-accent"
                  aria-hidden="true"
                />
                <p class="text-muted">{item}</p>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</Card>
