---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={["inline-flex items-center leading-none", className]}
  aria-hidden="true"
  translate="no"
>
  <img
    src="/images/brand/cm-logo-light.svg"
    alt=""
    class="h-[1.15em] w-auto dark:hidden"
    loading="eager"
    decoding="async"
  />
  <img
    src="/images/brand/cm-logo-dark.svg"
    alt=""
    class="hidden h-[1.15em] w-auto dark:block"
    loading="eager"
    decoding="async"
  />
</span>
