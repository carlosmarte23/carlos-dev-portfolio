---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-baseline font-mono leading-none font-bold tracking-normal",
    className,
  ]}
  aria-hidden="true"
>
  <span class="text-accent">&lt;</span>
  <span class="text-main">CM</span>
  <span class="text-accent">&nbsp;/&gt;</span>
</span>
