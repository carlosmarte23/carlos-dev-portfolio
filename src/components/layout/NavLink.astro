---
interface Props {
  href: string;
  label: string;
  activePath?: string;
}

const { href, label, activePath } = Astro.props;

const currentPath = Astro.url.pathname;
const normalizePath = (path: string) => {
  const pathWithoutHash = path.split("#")[0];

  return pathWithoutHash.endsWith("/")
    ? pathWithoutHash.slice(0, -1) || "/"
    : pathWithoutHash;
};

const normalizedPath = normalizePath(currentPath);
const normalizedHref = normalizePath(activePath ?? href);

const isHomeLink = normalizedHref === "/";

const isActive = isHomeLink
  ? normalizedPath === "/"
  : normalizedPath === normalizedHref ||
    normalizedPath.startsWith(`${normalizedHref}/`);

const classes = isActive
  ? "text-accent after:scale-x-100"
  : "text-main hover:text-accent after:scale-x-0";
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class={`relative inline-flex w-fit py-1 text-sm font-semibold transition after:bg-accent after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:rounded-full after:transition-transform after:content-[''] ${classes}`}
>
  {label}
</a>
