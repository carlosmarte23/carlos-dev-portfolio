---
import Container from "@components/ui/Container.astro";
import SocialLinks from "../ui/SocialLinks.astro";
import { Copyright, ArrowUp } from "@lucide/astro";

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-line py-6">
  <Container
    class="flex flex-col items-center justify-between gap-4 text-sm text-muted md:flex-row"
  >
    <p class="flex items-center gap-2 text-center md:text-left">
      <span> <Copyright class="size-5" aria-hidden="true" /> </span>
      {currentYear} Carlos Marte. All rights reserved
    </p>

    <div class="flex gap-4">
      <SocialLinks />

      <a
        href="#top"
        class="inline-flex size-9 items-center justify-center rounded-full border border-line text-soft transition hover:scale-125 hover:border-accent hover:bg-surface-muted hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        aria-label="Back to top"
      >
        <ArrowUp class="size-5" aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>
