---
import Container from "@components/ui/Container.astro";
import { Copyright, ArrowUp, Mail } from "@lucide/astro";
import GithubIcon from "@/components/icons/GithubIcon.astro";
import LinkedInIcon from "@components/icons/LinkedIn.astro";

const currentYear = new Date().getFullYear();

const links = [
  {
    href: "https://github.com/carlosmarte23",
    label: "GitHub",
    icon: GithubIcon,
    external: true,
  },
  {
    href: "https://www.linkedin.com/in/carlos-marte-4baa8138/",
    label: "LinkedIn",
    icon: LinkedInIcon,
    external: true,
  },
  {
    href: "mailto:carlosmartebloise@gmail.com?subject=Portfolio%20Contact",
    label: "Email",
    icon: Mail,
    external: false,
  },
];
---

<footer class="border-t border-line py-6">
  <Container
    class="flex flex-col items-center justify-between gap-4 text-sm text-muted md:flex-row"
  >
    <p class="flex items-center gap-2 text-center md:text-left">
      <span> <Copyright class="size-5" aria-hidden="true" /> </span>
      {currentYear} Carlos Marte. All rights reserved
    </p>

    <div class="flex gap-4">
      <nav class="flex items-center gap-6" aria-label="Footer navigation">
        {
          links.map((link) => (
            <a
              href={link.href}
              class="flex items-center justify-between gap-2 text-main transition hover:scale-125 hover:text-accent"
              aria-label={link.label}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noopener noreferrer" : undefined}
            >
              <link.icon class="size-5" aria-hidden="true" />
            </a>
          ))
        }
      </nav>

      <a
        href="#top"
        class="inline-flex size-9 items-center justify-center rounded-full border border-line text-soft transition hover:scale-125 hover:border-accent hover:bg-surface-muted hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
        aria-label="Back to top"
      >
        <ArrowUp class="size-5" aria-hidden="true" />
      </a>
    </div>
  </Container>
</footer>
