---
const label = "Toggle Theme";
---

<button
  type="button"
  aria-label={label}
  class="inline-flex h-8 w-14 items-center justify-end rounded-full border border-line bg-surface px-1 transition hover:bg-surface-muted focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
>
  <span class="size-6 rounded-full bg-accent shadow"></span>
</button>
