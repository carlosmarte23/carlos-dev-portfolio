---
import type { ProjectCaseStudy } from "@data/projects";
import Card from "@/components/ui/Card.astro";
import { BadgeCheck, CircleAlert, PanelsTopLeft } from "@lucide/astro";

interface Props {
  caseStudy: ProjectCaseStudy;
}

const { caseStudy } = Astro.props;
---

<section class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
  <Card padding="sm" class="space-y-4">
    <div class="flex items-center gap-3">
      <PanelsTopLeft class="size-8 text-accent" aria-hidden="true" />
      <h3 class="font-display text-xl font-bold text-main">Overview</h3>
    </div>
    <p class="text-muted">{caseStudy.overview}</p>
  </Card>

  <Card padding="sm" class="space-y-4">
    <div class="flex items-center gap-3">
      <CircleAlert class="size-8 text-accent" aria-hidden="true" />
      <h3 class="font-display text-xl font-bold text-main">Problem</h3>
    </div>
    <p class="text-muted">{caseStudy.problem}</p>
  </Card>

  <Card padding="sm" class="space-y-4">
    <div class="flex items-center gap-3">
      <BadgeCheck class="size-8 text-accent" aria-hidden="true" />
      <h3 class="font-display text-xl font-bold text-main">Solution</h3>
    </div>
    <p class="text-muted">{caseStudy.solution}</p>
  </Card>
</section>
