---
import type { Project, ProjectDetailContent } from "@content-types/content";
import Button from "@/components/ui/Button.astro";
import TerminalCard from "@/components/ui/TerminalCard.astro";
import ProjectTechStrip from "@/components/projects/ProjectTechStrip.astro";
import { ArrowLeft, ExternalLink } from "@lucide/astro";
import { Icon } from "astro-icon/components";

interface Props {
  project: Project;
  backLabel: string;
  eyebrow: string;
  techStackContent: ProjectDetailContent["techStack"];
}

const { project, backLabel, eyebrow, techStackContent } = Astro.props;
---

<a
  href="/#projects"
  class="flex animate-fade-in-up items-center gap-2 text-accent animate-bezier-expo-out animate-duration-fast"
>
  <ArrowLeft class="size-4" aria-hidden="true" />
  {backLabel}
</a>

<header class="grid grid-cols-1 gap-5 lg:grid-cols-2">
  <div
    class="flex animate-fade-in-up flex-col gap-3 animate-delay-100 animate-bezier-expo-out animate-duration-slow"
  >
    <p
      class="flex items-center gap-3 font-mono text-sm font-semibold text-accent uppercase"
    >
      <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
      {eyebrow}
    </p>
    <h1
      class="font-display text-4xl font-bold"
      transition:name={`project-title-${project.slug}`}
    >
      {project.title}
    </h1>
    <h2 class="text-xl font-semibold text-muted">
      {project.summary}
    </h2>
    <p class="text-muted">{project.description}</p>

    <div class="flex flex-col flex-wrap gap-2 md:flex-row">
      {
        project.links.map((link) => (
          <Button
            href={link.href}
            target={link.isExternal ? "_blank" : undefined}
            rel={link.isExternal ? "noopener noreferrer" : undefined}
            variant={link.type === "live" ? "primary" : "secondary"}
            aria-label={`Open ${project.title} ${link.label}`}
          >
            {link.type === "github" && (
              <Icon
                name="simple-icons:github"
                class="size-4"
                aria-hidden="true"
              />
            )}
            {link.label}
            {link.type === "live" && (
              <ExternalLink class="size-4" aria-hidden="true" />
            )}
          </Button>
        ))
      }
    </div>

    <ProjectTechStrip
      techStack={project.stack}
      categoryLabels={techStackContent.featuredCategoryLabels}
    />
  </div>

  <TerminalCard
    class="animate-slide-up-fade self-start animate-delay-200 animate-bezier-expo-out animate-duration-slow"
    bodyClass="p-0"
  >
    <div class="aspect-16/10 overflow-hidden">
      <img
        src={project.coverImage.src}
        alt={project.coverImage.alt}
        class="size-full object-cover object-top"
        transition:name={`project-image-${project.slug}`}
      />
    </div>
  </TerminalCard>
</header>
