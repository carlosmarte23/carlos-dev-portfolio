---
import type { Project } from "@data/projects";
import Card from "@/components/ui/Card.astro";
import Badge from "@/components/ui/Badge.astro";
import {
  CalendarRangeIcon,
  CircleCheckBig,
  Goal,
  Layers,
  Notebook,
  User,
} from "@lucide/astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<section>
  <Card padding="sm" class="space-y-4">
    <div class="flex items-center gap-3">
      <Notebook class="size-8 text-accent" aria-hidden="true" />
      <h3 class="font-display text-xl font-bold text-main">Project facts</h3>
    </div>

    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-4">
      <Card padding="sm" class="flex flex-row gap-3">
        <User class="size-8 text-accent" aria-hidden="true" />
        <div class="flex flex-col gap-0.5">
          <h4 class="font-display text-lg font-semibold text-main">Role</h4>
          <p class="text-muted">{project.role}</p>
        </div>
      </Card>

      <Card padding="sm" class="flex flex-row gap-3">
        <Layers class="size-8 text-accent" aria-hidden="true" />
        <div class="flex flex-col gap-0.5">
          <h4 class="font-display text-lg font-semibold text-main">Type</h4>
          <p class="text-muted">{project.type}</p>
        </div>
      </Card>

      <Card padding="sm" class="flex flex-row gap-3">
        <CircleCheckBig class="size-8 text-accent" aria-hidden="true" />
        <div class="flex flex-col gap-0.5">
          <h4 class="font-display text-lg font-semibold text-main">Status</h4>
          <Badge variant="featured" class="text-muted uppercase">
            {project.status}
          </Badge>
        </div>
      </Card>

      <Card padding="sm" class="flex flex-row gap-3">
        <CalendarRangeIcon class="size-8 text-accent" aria-hidden="true" />
        <div class="flex flex-col gap-0.5">
          <h4 class="font-display text-lg font-semibold text-main">Timeline</h4>
          <p class="text-muted">{project.timeline}</p>
        </div>
      </Card>
    </div>

    <Card padding="sm" class="flex flex-col gap-5 md:flex-row">
      <div class="flex items-center gap-3">
        <Goal class="size-8 text-accent" aria-hidden="true" />
        <h3 class="font-display text-xl font-bold text-main">Focus</h3>
      </div>

      <div class="flex flex-wrap gap-2">
        {
          project.focus.map((focus) => (
            <div class="flex flex-col gap-0.5">
              <Badge
                variant="featured"
                class="font-display text-lg font-semibold text-main"
              >
                {focus}
              </Badge>
            </div>
          ))
        }
      </div>
    </Card>
  </Card>
</section>
