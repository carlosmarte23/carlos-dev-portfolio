---
import Card from "@/components/ui/Card.astro";
import { Icon } from "astro-icon/components";
import { CodeXml } from "@lucide/astro";
import type { ProjectDetailContent, ProjectTech } from "@content-types/content";
import { skills } from "@data/skills";
import type { Skill } from "@content-types/content";

interface Props {
  techStack: ProjectTech[];
  content: ProjectDetailContent["techStack"];
}

const { techStack, content } = Astro.props;

type TechDisplayGroup = {
  id: string;
  label: string;
  categories: ProjectTech["category"][];
  rowClasses: string;
  chipClasses: string;
};

const displayGroups: TechDisplayGroup[] = [
  {
    id: "frontend",
    label: content.groupLabels.frontend ?? "Frontend",
    categories: ["frontend", "routing", "state"],
    rowClasses:
      "border-cyan-200 bg-cyan-50 dark:border-cyan-400/15 dark:bg-cyan-400/5",
    chipClasses:
      "bg-cyan-100 text-cyan-800 ring-cyan-300/70 dark:bg-cyan-400/15 dark:text-cyan-200 dark:ring-cyan-300/20",
  },
  {
    id: "tooling",
    label: content.groupLabels.tooling ?? "Tooling",
    categories: ["tooling"],
    rowClasses:
      "border-violet-200 bg-violet-50 dark:border-violet-400/15 dark:bg-violet-400/5",
    chipClasses:
      "bg-violet-100 text-violet-800 ring-violet-300/70 dark:bg-violet-400/15 dark:text-violet-200 dark:ring-violet-300/20",
  },
  {
    id: "data",
    label: content.groupLabels.data ?? "Data",
    categories: ["data"],
    rowClasses:
      "border-teal-200 bg-teal-50 dark:border-teal-400/15 dark:bg-teal-400/5",
    chipClasses:
      "bg-teal-100 text-teal-800 ring-teal-300/70 dark:bg-teal-400/15 dark:text-teal-200 dark:ring-teal-300/20",
  },
  {
    id: "language",
    label: content.groupLabels.language ?? "Language",
    categories: ["language"],
    rowClasses:
      "border-indigo-200 bg-indigo-50 dark:border-indigo-400/15 dark:bg-indigo-400/5",
    chipClasses:
      "bg-indigo-100 text-indigo-800 ring-indigo-300/70 dark:bg-indigo-400/15 dark:text-indigo-200 dark:ring-indigo-300/20",
  },
  {
    id: "backend",
    label: content.groupLabels.backend ?? "Backend",
    categories: ["backend"],
    rowClasses:
      "border-sky-200 bg-sky-50 dark:border-sky-400/15 dark:bg-sky-400/5",
    chipClasses:
      "bg-sky-100 text-sky-800 ring-sky-300/70 dark:bg-sky-400/15 dark:text-sky-200 dark:ring-sky-300/20",
  },
  {
    id: "styling",
    label: content.groupLabels.styling ?? "Styling",
    categories: ["styling"],
    rowClasses:
      "border-emerald-200 bg-emerald-50 dark:border-emerald-400/15 dark:bg-emerald-400/5",
    chipClasses:
      "bg-emerald-100 text-emerald-800 ring-emerald-300/70 dark:bg-emerald-400/15 dark:text-emerald-200 dark:ring-emerald-300/20",
  },
  {
    id: "testing",
    label: content.groupLabels.testing ?? "Testing",
    categories: ["testing"],
    rowClasses:
      "border-fuchsia-200 bg-fuchsia-50 dark:border-fuchsia-400/15 dark:bg-fuchsia-400/5",
    chipClasses:
      "bg-fuchsia-100 text-fuchsia-800 ring-fuchsia-300/70 dark:bg-fuchsia-400/15 dark:text-fuchsia-200 dark:ring-fuchsia-300/20",
  },
  {
    id: "browser-api",
    label: content.groupLabels["browser-api"] ?? "Browser APIs",
    categories: ["browser-api"],
    rowClasses:
      "border-orange-200 bg-orange-50 dark:border-orange-400/15 dark:bg-orange-400/5",
    chipClasses:
      "bg-orange-100 text-orange-800 ring-orange-300/70 dark:bg-orange-400/15 dark:text-orange-200 dark:ring-orange-300/20",
  },
];

const normalize = (value: string) => value.toLowerCase().trim();

const getSkillIcon = (
  tech: ProjectTech,
): Pick<Skill, "icon" | "fallbackLabel"> | undefined => {
  if (tech.icon) {
    return {
      icon: tech.icon,
      fallbackLabel: tech.fallbackLabel,
    };
  }

  return skills.find((skill) => normalize(skill.name) === normalize(tech.name));
};

const groupedTech = displayGroups
  .map((group) => ({
    ...group,
    items: techStack.filter((tech) => group.categories.includes(tech.category)),
  }))
  .filter((group) => group.items.length > 0);
---

<Card
  class="animate-slide-up-fade space-y-4 animate-bezier-expo-out animate-duration-slow animate-range-[entry_0%_contain_20%] timeline-view"
>
  <h2 class="flex items-center gap-3 font-display text-xl font-bold text-main">
    <CodeXml class="size-5 text-accent" aria-hidden="true" />
    {content.title}
  </h2>

  <ul class="space-y-3" role="list">
    {
      groupedTech.map((group) => (
        <li
          class={`rounded-xl border p-4 sm:flex sm:items-center sm:gap-5 ${group.rowClasses}`}
        >
          <h3 class="mb-3 min-w-28 text-sm font-bold text-main sm:mb-0">
            {group.label}
          </h3>

          <ul
            class="flex flex-wrap gap-2"
            role="list"
            aria-label={`${group.label} technologies`}
          >
            {group.items.map((tech) => {
              const icon = getSkillIcon(tech);
              const isIconifyIcon = Boolean(icon?.icon.includes(":"));

              return (
                <li>
                  <span
                    class={`inline-flex items-center gap-2 rounded-md px-3 py-1.5 text-xs font-semibold ring-1 ${group.chipClasses}`}
                  >
                    {isIconifyIcon && icon?.icon ? (
                      <Icon
                        name={icon.icon}
                        class="size-4"
                        aria-hidden="true"
                      />
                    ) : icon?.fallbackLabel ? (
                      <span class="font-mono text-[0.65rem] leading-none">
                        {icon.fallbackLabel}
                      </span>
                    ) : (
                      <CodeXml class="size-4" aria-hidden="true" />
                    )}
                    {tech.name}
                  </span>
                </li>
              );
            })}
          </ul>
        </li>
      ))
    }
  </ul>
</Card>
