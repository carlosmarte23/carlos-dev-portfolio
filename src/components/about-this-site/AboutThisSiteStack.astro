---
import Card from "@/components/ui/Card.astro";
import type { AboutThisSitePage } from "@content-types/content";
import { Icon } from "astro-icon/components";
import { Braces } from "@lucide/astro";

interface Props {
  stack: AboutThisSitePage["stack"];
}

const { stack } = Astro.props;
const { title, description, items } = stack;

const needsLightIconBackground = (icon: string) => icon === "devicon:astro";
---

<section class="flex h-full flex-col gap-2">
  <Card padding="md" class="flex h-full flex-col gap-4">
    <header class="flex flex-col gap-3">
      <div class="flex flex-row items-center gap-3 lg:gap-4">
        <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
        <p class="font-mono text-sm font-semibold text-accent uppercase">
          {title}
        </p>
      </div>
    </header>

    <p class="text-sm text-muted">
      {description}
    </p>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        items.map((item) => (
          <Card padding="sm" class="h-full">
            <article class="flex h-full flex-col gap-4">
              <div class="flex items-start justify-between gap-3">
                <div
                  class:list={[
                    "flex size-14 shrink-0 items-center justify-center rounded-xl border border-line",
                    needsLightIconBackground(item.icon)
                      ? "bg-white"
                      : "bg-surface-muted",
                  ]}
                >
                  {item.icon.includes(":") ? (
                    <Icon
                      name={item.icon}
                      class="size-9"
                      aria-hidden="true"
                    />
                  ) : (
                    <Braces class="size-8 text-accent" aria-hidden="true" />
                  )}
                </div>

                <span class="font-mono text-xs font-semibold text-accent">
                  {item.category}
                </span>
              </div>

              <div class="flex flex-1 flex-col gap-2">
                <h3 class="font-display text-lg font-bold text-main">
                  {item.name}
                </h3>

                <p class="text-sm leading-6 text-muted">{item.description}</p>
              </div>
            </article>
          </Card>
        ))
      }
    </div>
  </Card>
</section>
