---
import Container from "../ui/Container.astro";
import { FolderOpen } from "@lucide/astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { getFeaturedProjects } from "@data/projects";

const featuredProjects = getFeaturedProjects();
---

<section id="projects" class="scroll-mt-22">
  <Container>
    <header
      class="w-max-container mx-auto my-12 flex items-center border-b border-line py-4"
    >
      <h2
        class="flex items-center justify-between gap-4 font-mono text-lg font-bold"
      >
        <span class="size-4 text-accent"><FolderOpen /></span> Projects
      </h2>
    </header>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <ProjectCard
            title={project.title}
            summary={project.summary}
            image={project.image.src}
            imageAlt={project.image.alt}
            stack={project.techStack}
            links={project.links}
            slug={project.slug}
            featured={project.isFeatured}
            status={project.status}
          />
        ))
      }
    </div>
  </Container>
</section>
