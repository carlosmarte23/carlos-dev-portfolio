---
import Container from "../ui/Container.astro";
import { FolderOpen } from "@lucide/astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { getFeaturedProjects } from "@data/projects";
import { homePage } from "@data/pages/home";

const featuredProjects = getFeaturedProjects().slice(0, 3);
const { projects: projectsSection } = homePage.sections;
const delayClasses = [
  "animate-delay-0",
  "animate-delay-100",
  "animate-delay-200",
];
---

<section id="projects" class="scroll-mt-22">
  <Container>
    <header
      class="w-max-container mx-auto my-8 flex animate-fade-in-up items-center border-b border-line py-3 animate-bezier-expo-out animate-duration-slow animate-range-[entry_10%_contain_25%] timeline-view"
    >
      <h2
        class="flex items-center justify-between gap-4 font-mono text-lg font-bold"
      >
        <span class="size-4 text-accent"><FolderOpen /></span>
        {projectsSection.title}
      </h2>
    </header>

    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {
        featuredProjects.map((project, index) => (
          <div
            class={`animate-slide-up-fade animate-bezier-expo-out animate-duration-slow animate-range-[entry_10%_contain_25%] timeline-view ${delayClasses[index % delayClasses.length]}`}
          >
            <ProjectCard
              title={project.title}
              summary={project.summary}
              image={project.coverImage.src}
              imageAlt={project.coverImage.alt}
              stack={project.stack}
              links={project.links}
              slug={project.slug}
              featured={project.featured}
              featuredLabel={projectsSection.featuredBadgeLabel}
              status={project.status}
            />
          </div>
        ))
      }
    </div>
  </Container>
</section>
