---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import TerminalCard from "@/components/ui/TerminalCard.astro";
import { ArrowRight, ChevronRight, UserRound } from "@lucide/astro";

import { site } from "@data/site";
import { homePage } from "@data/pages/home";
const { name, location, role } = site;

const {
  preview,
  positioning,
  currentStrength,
  professionalInterests,
  currentGoal,
  openToWork,
} = homePage.profileSummary;
---

<section>
  <Container>
    <header
      class="w-max-container mx-auto my-12 flex items-center justify-between border-b border-line py-4"
    >
      <h2
        class="flex items-baseline justify-between gap-4 font-mono text-lg font-bold"
      >
        <span class="size-4 text-accent"><UserRound /></span> About Me
      </h2>
    </header>

    <div class="grid gap-5 md:grid-cols-2">
      <div>
        <p class="leading-6 text-pretty text-muted">{preview}</p>
        <Button href="/about" class="mt-6" variant="secondary">
          More About Me
          <span><ArrowRight /></span>
        </Button>
      </div>
      <div class="w-full lg:max-w-xl xl:max-w-2xl">
        <TerminalCard class="lg:ml-auto">
          <div class="space-y-2">
            <p class="text-accent">// About profile</p>
            <p>
              <span class="text-accent">const</span>
              <span class="text-main"> developer </span>
              <span class="text-muted">=</span>
              <span class="text-main"> {"{"}</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">name</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{name}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">location</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{location}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">role</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{role}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">direction</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{positioning}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">currentStrength</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{currentStrength}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">interests</span>
              <span class="text-muted">: [</span>
            </p>

            <div class="space-y-1 pl-8">
              {
                professionalInterests.map((interest, index) => (
                  <div class="flex items-start gap-2">
                    <ChevronRight
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    <span>
                      <span class="text-accent">"{interest}"</span>
                      <span class="text-muted">
                        {index === professionalInterests.length - 1 ? "" : ","}
                      </span>
                    </span>
                  </div>
                ))
              }
            </div>

            <p class="pl-4">
              <span class="text-muted">]</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">currentGoal</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{currentGoal}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">openToWork</span>
              <span class="text-muted">: </span>
              <span class="text-yellow-300">{String(openToWork)}</span>
            </p>

            <p>
              <span class="text-main">{"}"}</span>
              <span class="text-muted">;</span>
            </p>

            <span
              class="inline-block h-4 w-2 animate-flash bg-accent animate-iteration-count-infinite"
              aria-hidden="true"></span>
          </div>
        </TerminalCard>
      </div>
    </div>
  </Container>
</section>
