---
import Container from "../ui/Container.astro";
import TerminalCard from "../ui/TerminalCard.astro";
import Button from "../ui/Button.astro";
import SocialLinks from "../ui/SocialLinks.astro";

import { ArrowRight, ArrowDown, Mail, ChevronRight } from "@lucide/astro";

import { site } from "@data/site";

const { hero, cta } = site;
---

<section
  class="relative py-10 md:flex md:h-[calc(100svh-var(--header-height))] md:items-center md:pt-14 md:pb-28 lg:pt-24 lg:pb-24"
>
  <Container>
    <div class="grid w-full gap-10 lg:grid-cols-2 lg:items-center">
      <div class="grid gap-6">
        <p
          class="flex items-center gap-3 font-mono text-sm font-semibold tracking-wide text-accent uppercase"
        >
          <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"
          ></span>
          {hero.eyebrow}
        </p>
        <h1
          class="font-display text-5xl font-bold tracking-tight sm:text-5xl lg:text-6xl"
        >
          {hero.headline.main}
          <span class="text-accent">{hero.headline.accent}</span>
        </h1>
        <p class="max-w-lg text-pretty text-muted lg:max-w-[42ch]">
          {hero.description}
        </p>

        <div class="flex flex-col gap-3 md:flex-row">
          <Button href={cta.primary.href} class="button">
            {cta.primary.label}
            <span><ArrowRight class="size-4" aria-hidden="true" /></span>
          </Button>
          <Button variant="secondary" href={cta.secondary.href} class="button">
            {cta.secondary.label}
            <span><Mail class="size-4" aria-hidden="true" /></span>
          </Button>
        </div>

        <div class="flex justify-center md:justify-start">
          <SocialLinks />
        </div>
      </div>
      <div class="w-full lg:max-w-xl xl:max-w-2xl">
        <TerminalCard class="lg:ml-auto">
          <div class="space-y-2">
            <p class="text-accent">// Current profile</p>
            <p>
              <span class="text-accent">const</span>
              <span class="text-main"> developer </span>
              <span class="text-muted">=</span>
              <span class="text-main"> {"{"}</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">name</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"Carlos Marte"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">skills</span>
              <span class="text-muted">: [</span>
            </p>

            <div class="space-y-1 pl-8">
              {
                hero.skills.map((skill, index) => (
                  <div class="flex items-start gap-2">
                    <ChevronRight
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    <span>
                      <span class="text-accent">"{skill}"</span>
                      <span class="text-muted">
                        {index === hero.skills.length - 1 ? "" : ","}
                      </span>
                    </span>
                  </div>
                ))
              }
            </div>

            <p class="pl-4">
              <span class="text-muted">]</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">status</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"Open to work"</span>
            </p>

            <p>
              <span class="text-main">{"}"}</span>
              <span class="text-muted">;</span>
            </p>

            <span
              class="inline-block h-4 w-2 animate-flash bg-accent animate-iteration-count-infinite"
              aria-hidden="true"></span>
          </div>
        </TerminalCard>
      </div>
    </div>
  </Container>
  <a
    href="#projects"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-xs font-semibold text-soft transition hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent md:flex"
    aria-label="Scroll to projects"
  >
    <span class="tracking-wide uppercase">Scroll</span>

    <span
      class="flex size-9 animate-bounce items-center justify-center rounded-full border border-line bg-surface text-accent shadow-card"
      aria-hidden="true"
    >
      <ArrowDown />
    </span>
  </a>
</section>
