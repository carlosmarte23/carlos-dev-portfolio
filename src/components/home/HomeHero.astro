---
import Container from "../ui/Container.astro";
import TerminalCard from "../ui/TerminalCard.astro";
import Button from "../ui/Button.astro";
import SocialLinks from "../ui/SocialLinks.astro";

import { ArrowRight, ArrowDown, Mail, ChevronRight } from "@lucide/astro";

import { homePage } from "@data/pages/home";
import { site } from "@data/site";

const { hero } = homePage;
const { cta } = hero;
---

<section
  class="relative py-8 md:flex md:min-h-[34rem] md:items-center md:pt-10 md:pb-16 lg:py-14"
>
  <Container>
    <div class="grid w-full gap-10 lg:grid-cols-2 lg:items-center">
      <div class="grid gap-6">
        <p
          class="flex items-center gap-3 font-mono text-sm font-semibold tracking-wide text-accent uppercase"
        >
          <span
            class="size-2.5 animate-fade-in-up rounded-full bg-accent animate-bezier-expo-out animate-duration-slow"
            aria-hidden="true"></span>
          {hero.eyebrow}
        </p>
        <h1
          class="animate-fade-in-up font-display text-5xl font-bold tracking-tight animate-delay-100 animate-bezier-expo-out animate-duration-slow sm:text-5xl lg:text-6xl"
        >
          {hero.headline.main}
          <span class="text-accent">{hero.headline.accent}</span>
        </h1>
        <p
          class="max-w-lg animate-fade-in-up text-pretty text-muted animate-delay-200 animate-bezier-expo-out animate-duration-slow lg:max-w-[42ch]"
        >
          {hero.description}
        </p>

        <div
          class="flex animate-fade-in-up flex-col gap-3 animate-delay-300 animate-bezier-expo-out animate-duration-slow md:flex-row"
        >
          <Button href={cta.primary.href} class="button">
            {cta.primary.label}
            <span><ArrowRight class="size-4" aria-hidden="true" /></span>
          </Button>
          <Button variant="secondary" href={cta.secondary.href} class="button">
            {cta.secondary.label}
            <span><Mail class="size-4" aria-hidden="true" /></span>
          </Button>
        </div>

        <div
          class="flex animate-fade-in-up justify-center animate-delay-300 animate-bezier-expo-out animate-duration-slow md:justify-start"
        >
          <SocialLinks />
        </div>
      </div>
      <div class="w-full lg:max-w-xl xl:max-w-2xl">
        <TerminalCard
          class="animate-fade-in-up animate-delay-200 animate-bezier-expo-out animate-duration-slow lg:ml-auto"
        >
          <div class="space-y-2">
            <p class="text-accent">// {hero.terminal.comment}</p>
            <p>
              <span class="text-accent">const</span>
              <span class="text-main"> developer </span>
              <span class="text-muted">=</span>
              <span class="text-main"> {"{"}</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">{hero.terminal.nameLabel}</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{site.name}"</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">{hero.terminal.skillsLabel}</span>
              <span class="text-muted">: [</span>
            </p>

            <div class="space-y-1 pl-8">
              {
                hero.skills.map((skill, index) => (
                  <div class="flex items-start gap-2">
                    <ChevronRight
                      class="mt-0.5 size-4 shrink-0 text-accent"
                      aria-hidden="true"
                    />
                    <span>
                      <span class="text-accent">"{skill}"</span>
                      <span class="text-muted">
                        {index === hero.skills.length - 1 ? "" : ","}
                      </span>
                    </span>
                  </div>
                ))
              }
            </div>

            <p class="pl-4">
              <span class="text-muted">]</span>
              <span class="text-muted">,</span>
            </p>

            <p class="pl-4">
              <span class="text-blue-400">{hero.terminal.statusLabel}</span>
              <span class="text-muted">: </span>
              <span class="text-accent">"{site.availability}"</span>
            </p>

            <p>
              <span class="text-main">{"}"}</span>
              <span class="text-muted">;</span>
            </p>

            <span
              class="inline-block h-4 w-2 animate-flash bg-accent animate-iteration-count-infinite"
              aria-hidden="true"></span>
          </div>
        </TerminalCard>
      </div>
    </div>
  </Container>
  <a
    href={hero.scroll.href}
    class="absolute bottom-4 left-1/2 hidden -translate-x-1/2 animate-fade-in-up flex-col items-center gap-2 font-mono text-xs font-semibold text-soft transition animate-delay-400 animate-bezier-expo-out animate-duration-slow hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent md:flex"
    aria-label={hero.scroll.ariaLabel}
  >
    <span class="tracking-wide uppercase">{hero.scroll.label}</span>

    <span
      class="flex size-9 animate-bounce items-center justify-center rounded-full border border-line bg-surface text-accent shadow-card"
      aria-hidden="true"
    >
      <ArrowDown />
    </span>
  </a>
</section>
