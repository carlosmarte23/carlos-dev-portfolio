---
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import { Rocket, ArrowRight } from "@lucide/astro";
---

<section class="py-10">
  <Container>
    <Card
      padding="sm"
      class="flex flex-col items-center gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div class="flex flex-row items-center gap-6 md:gap-12">
        <Rocket class="size-12 text-accent md:size-9" aria-hidden="true" />
        <div>
          <h2 class="font-display text-xl font-bold text-main">
            Have a project in mind?
          </h2>
          <p class="mt-1 text-muted">Let's build something amazing together.</p>
        </div>
      </div>

      <Button href="/contact" class="w-full md:w-auto">
        Get in touch
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </Card>
  </Container>
</section>
