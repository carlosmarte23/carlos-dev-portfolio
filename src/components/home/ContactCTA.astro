---
import Container from "@/components/ui/Container.astro";
import Card from "@/components/ui/Card.astro";
import Button from "@/components/ui/Button.astro";
import { Rocket, ArrowRight } from "@lucide/astro";
import { homePage } from "@data/pages/home";

const { contactCta } = homePage;
---

<section class="my-5">
  <Container>
    <Card
      padding="sm"
      class="flex flex-col items-center gap-6 md:flex-row md:items-center md:justify-between"
    >
      <div class="flex flex-row items-center gap-6 md:gap-12">
        <Rocket class="size-12 text-accent md:size-9" aria-hidden="true" />
        <div>
          <h2 class="font-display text-xl font-bold text-main">
            {contactCta.title}
          </h2>
          <p class="mt-1 text-muted">{contactCta.description}</p>
        </div>
      </div>

      <Button href={contactCta.primaryHref} class="w-full md:w-auto">
        {contactCta.primaryLabel}
        <ArrowRight class="size-4" aria-hidden="true" />
      </Button>
    </Card>
  </Container>
</section>
