---
type Variant = "default" | "featured" | "tech" | "muted" | "card";

interface Props {
  variant?: Variant;
  class?: string;
}

const { variant = "default", class: className = "" } = Astro.props;

const baseClasses =
  "inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold leading-none";

const variantClasses: Record<Variant, string> = {
  default: "bg-surface-muted text-muted",
  featured: "border border-accent/40 bg-accent-soft text-accent",
  tech: "bg-accent-soft text-accent",
  muted: "bg-surface-muted text-muted",
  card: " bg-violet-500 px-2.5 py-1 font-bold text-white uppercase",
};

const classes = `${baseClasses} ${variantClasses[variant]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
