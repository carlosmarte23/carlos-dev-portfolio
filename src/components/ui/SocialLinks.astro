---
import { Icon } from "astro-icon/components";
import { Mail } from "@lucide/astro";
import { socialLinks } from "@data/socialLinks";
import type { SocialLinkIcon } from "@content-types/content";

interface Props {
  label?: string;
}

const { label = "Social links" } = Astro.props;
const links = socialLinks;

const brandIcons: Partial<Record<SocialLinkIcon, string>> = {
  github: "simple-icons:github",
  linkedin: "simple-icons:linkedin",
};
---

<nav class="flex items-center gap-6" aria-label={label}>
  {
    links.map((link) => {
      const brandIcon = brandIcons[link.icon];

      return (
        <a
          href={link.href}
          class="flex items-center justify-between gap-2 text-main transition hover:scale-125 hover:text-accent"
          aria-label={link.label}
          target={link.isExternal ? "_blank" : undefined}
          rel={link.isExternal ? "noopener noreferrer" : undefined}
        >
          {brandIcon ? (
            <Icon name={brandIcon} class="size-5" aria-hidden="true" />
          ) : (
            <Mail class="size-5" aria-hidden="true" />
          )}
        </a>
      );
    })
  }
</nav>
