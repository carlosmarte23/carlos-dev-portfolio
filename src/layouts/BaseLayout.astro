---
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/space-grotesk/wght.css";
import "@fontsource-variable/jetbrains-mono/wght.css";
import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import { site } from "@data/site";
import { socialLinks } from "@data/socialLinks";

const {
  title = site.seo.title,
  description = site.seo.description,
  ogImage = site.seo.ogImage,
  ogImageAlt = site.seo.ogImageAlt,
  canonical = new URL(Astro.url.pathname, site.url).toString(),
  structuredData = [],
} = Astro.props;

const absoluteOgImage = ogImage
  ? new URL(ogImage, site.url).toString()
  : undefined;

const structuredDataGraph = [
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: site.seo.description,
    inLanguage: site.language,
    publisher: {
      "@id": `${site.url}/#person`,
    },
  },
  {
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: site.name,
    jobTitle: site.role,
    description: site.headline,
    url: site.url,
    email: site.email,
    address: {
      "@type": "PostalAddress",
      addressLocality: site.location,
    },
    sameAs: socialLinks
      .filter((link) => link.isExternal)
      .map((link) => link.href),
  },
  ...structuredData,
];

const structuredDataJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": structuredDataGraph,
}).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={structuredDataJson}
    />
    <script is:inline>
      (() => {
        const getPreferredTheme = () => {
          const storedTheme = localStorage.getItem("theme");
          const systemPrefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;

          return storedTheme === "light" || storedTheme === "dark"
            ? storedTheme
            : systemPrefersDark
              ? "dark"
              : "light";
        };

        const applyTheme = (root) => {
          const theme = getPreferredTheme();

          root.classList.toggle("dark", theme === "dark");
          root.dataset.theme = theme;
        };

        applyTheme(document.documentElement);

        if (!window.__portfolioThemeBeforeSwapReady) {
          window.__portfolioThemeBeforeSwapReady = true;

          document.addEventListener("astro:before-swap", (event) => {
            applyTheme(event.newDocument.documentElement);
          });
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const scrollRevealWindow = window;

        const revealSelector = ".timeline-view";
        const minVisibleRatio = 0.33;

        const getVisibleRatio = (element) => {
          const rect = element.getBoundingClientRect();
          const viewportHeight =
            window.innerHeight || document.documentElement.clientHeight;
          const visibleTop = Math.max(rect.top, 0);
          const visibleBottom = Math.min(rect.bottom, viewportHeight);
          const visibleHeight = Math.max(visibleBottom - visibleTop, 0);

          return rect.height > 0 ? visibleHeight / rect.height : 0;
        };

        const revealElement = (element) => {
          element.classList.add("is-revealed");
        };

        const revealVisibleElements = () => {
          document.querySelectorAll(revealSelector).forEach((element) => {
            if (getVisibleRatio(element) >= minVisibleRatio) {
              revealElement(element);
            }
          });
        };

        const setupScrollReveals = () => {
          document.documentElement.classList.add("scroll-reveals-ready");

          const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
          ).matches;

          if (prefersReducedMotion || !("IntersectionObserver" in window)) {
            document.querySelectorAll(revealSelector).forEach(revealElement);
            return;
          }

          const revealState = (scrollRevealWindow.__portfolioScrollReveal ??= {
            hasScrolled: false,
            observer: null,
          });

          if (!revealState.observer) {
            revealState.observer = new IntersectionObserver(
              (entries) => {
                if (!revealState.hasScrolled) return;

                entries.forEach((entry) => {
                  if (entry.intersectionRatio >= minVisibleRatio) {
                    revealElement(entry.target);
                    revealState.observer?.unobserve(entry.target);
                  }
                });
              },
              {
                threshold: [0, 0.25, minVisibleRatio, 0.5, 0.75, 1],
              },
            );
          }

          document
            .querySelectorAll(`${revealSelector}:not(.is-revealed)`)
            .forEach((element) => {
              revealState.observer.observe(element);
            });
        };

        const markScrolled = () => {
          const revealState = (scrollRevealWindow.__portfolioScrollReveal ??= {
            hasScrolled: false,
            observer: null,
          });

          revealState.hasScrolled = true;
          revealVisibleElements();
        };

        setupScrollReveals();

        if (!scrollRevealWindow.__portfolioScrollRevealReady) {
          scrollRevealWindow.__portfolioScrollRevealReady = true;

          window.addEventListener("scroll", markScrolled, { passive: true });
          document.addEventListener("astro:page-load", () => {
            const revealState = (scrollRevealWindow.__portfolioScrollReveal ??=
              {
                hasScrolled: false,
                observer: null,
              });

            revealState.hasScrolled = false;
            setupScrollReveals();
          });
        }
      })();
    </script>
    <ClientRouter fallback="animate" />
  </head>
  <body id="top" class="bg-app font-sans text-main antialiased">
    <div class="flex min-h-svh flex-col">
      <Header />
      <main class="flex-1 p-4">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
